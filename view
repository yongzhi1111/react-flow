        getPaged2({ logId }).then(res2 => {
          self.load = false;
          self.formData = res2.data || {};
          self.tabObjAll[logId] = res2.data || {};
          try {
            const taskExecLogs = res2.data.taskExecLogs
              ? res2.data.taskExecLogs
                  .map(item => ({
                    ...item,
                    resultData: JSON.parse(item.resultData || "{}")
                  }))
                  .filter(
                    item =>
                      item.taskNodeName !== "开始节点-startNode" &&
                      item.taskNodeName !== "结束节点-endNode"
                  )
              : [];
            self.taskExecLogs = taskExecLogs;
            const https_ = [];
            const formData2 = {};
            taskExecLogs.forEach((item, index) => {
              self.handleExpandChange(item, [item]);
              if (item.taskId) {
                https_.push(getTask({ taskId: item.taskId }));
              } else {
                formData2[index + ""] = {};
              }
            });
            Promise.all(https_).then(res => {
              res.forEach((item, index) => {
                formData2[index + ""] = item.data || {};
              });
              console.log(formData2);
              self.formData2 = formData2;
            });
          } catch (err) {
            self.taskExecLogs = [];
          }

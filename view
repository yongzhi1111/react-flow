        // self.formData.districtCode = self.formData.districtCode ? self.formData.districtCodesName : []
        // self.formData.districtCode = self.formData.districtCode ? JSON.parse(self.formData.districtCode) : []
      // });
    },
    handleExpandChange(row, expandedRows) {
      console.log(row, expandedRows);
      const self = this;
      self.loading3 = true;
      if (
        expandedRows.length &&
        row.resultCode !== "ERROR" &&
        !self.tabNode[row.taskNodeId]
      ) {
        getPaged3({
          taskNodeId: row.taskNodeId,
          flowId: self.formData.flowId
        }).then(res => {
          self.loading3 = false;
          let result 
          try {
            const rrr = row.resultData || {};
            result = {...(rrr.result || {}),...res.data} || {...row};
          } catch (err) {
            console.log(err, 'err============');
            result = {...res.data};
          }
          console.log(result, 'result============');
          self.tabNode[row.taskNodeId] = result;
        });
      } else {
